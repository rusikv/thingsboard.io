---
import ContactForm from '@components/ContactForm.astro';
import ContactsSection from '@components/Company/ContactsSection.astro';
import FormPage, { type ElsewhereItem } from '@components/Landing/FormPage.astro';
import { GITHUB_ISSUES_URL, SUPPORT_PORTAL_URL } from '@data/contact-form';

const INTRO = {
	eyebrow: 'Contact us',
	title: 'Let’s talk about what you’re building',
	lede: 'Planning a rollout, weighing up Private Cloud, or looking for a partner? Tell us a little about it, and someone from our team will write back by email.',
};
// Replaces the intro when a Private Cloud order lands here (`?pcorder`, from the pricing plans).
const ORDER_INTRO = {
	eyebrow: 'Private Cloud',
	title: 'Get your private IoT platform',
	lede: 'A dedicated ThingsBoard cluster, run by us for you. Tell us about your devices, your data and where you’d like it hosted, and we’ll come back with a setup and a quote sized to it.',
};

const ELSEWHERE: ElsewhereItem[] = [
	{
		icon: 'tabler:lifebuoy',
		lead: 'Already a customer?',
		label: 'Open a ticket in the Support portal',
		href: SUPPORT_PORTAL_URL,
		external: true,
	},
	{
		icon: 'tabler:brand-github',
		lead: 'Running ThingsBoard on your own servers?',
		label: 'Ask on GitHub issues',
		href: GITHUB_ISSUES_URL,
		external: true,
	},
	{
		icon: 'tabler:mail',
		lead: 'Prefer email?',
		label: 'info@thingsboard.io',
		href: 'mailto:info@thingsboard.io',
	},
];
---

<FormPage
	{...INTRO}
	metaTitle="Contact Us"
	description="Talk to the ThingsBoard team about your IoT project: products and pricing, Private Cloud, professional services, training or partnership."
	elsewhere={ELSEWHERE}
	introAttrs={{
		eyebrow: { 'data-intro': 'eyebrow' },
		title: { 'data-intro': 'title' },
		lede: { 'data-intro': 'lede' },
	}}
>
	<ContactForm />
	{/* Inline, so an order link never shows the default intro first. */}
	<script is:inline define:vars={{ ORDER_INTRO }}>
		if (new URLSearchParams(window.location.search).has('pcorder')) {
			Object.entries(ORDER_INTRO).forEach(([part, text]) => {
				const el = document.querySelector(`[data-intro="${part}"]`);
				if (el) el.textContent = text;
			});
		}
	</script>
	<div class="contact-print print:only">
		<ContactsSection />
	</div>
</FormPage>

<style lang="scss">
	@media print {
		.contact-print :global(.contacts-wrapper) {
			padding: 24px 0 0;
		}
	}
</style>
