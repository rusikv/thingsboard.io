---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Field from '@components/ui/Field.astro';
import Select from '@components/ui/Select.astro';
import {
	CLIENTS_TOPIC,
	CONTACT_TOPICS,
	DEFAULT_PROMPT,
	DEVICE_STEPS,
	GITHUB_ISSUES_URL,
	SUPPORT_PORTAL_URL,
	SUPPORT_TOPIC,
} from '@data/contact-form';

/**
 * The Contact us form. It posts natively to Formspree, which sends the reader on to the thank-you page
 * (`_next`). `?subject=` and `?message=` prefill it, `?pcorder` hides the topic, and `?resend` restores
 * the last message sent from this tab.
 */

const NOT_SURE = 'Not sure yet';

// A script reads the chosen option's data attributes: the message prompt, and what else the topic shows.
const TOPIC_OPTIONS = [
	{
		value: '',
		label: 'Choose a topic',
		selected: true,
		placeholder: true,
		attrs: { 'data-prompt': DEFAULT_PROMPT, 'data-devices': '' },
	},
	...CONTACT_TOPICS.map(({ group, options }) => ({
		group,
		options: options.map((topic) => ({
			value: topic.value,
			label: topic.label,
			attrs: {
				'data-prompt': topic.prompt,
				'data-devices': topic.devices ? '' : undefined,
				'data-clients': topic.value === CLIENTS_TOPIC ? '' : undefined,
				'data-support': topic.value === SUPPORT_TOPIC ? '' : undefined,
			},
		})),
	})),
];
---

<Card
	as="form"
	role="panel"
	class="cf contact-form gtm_form print:hidden"
	attrs={{ id: 'ContactUs', method: 'post', novalidate: 'novalidate' }}
>
	<h2 class="cf__title">Send us a message</h2>
	<fieldset class="cf__fields">
		<legend class="ui-sr">Your details and message</legend>
		<Field
			name="firstName"
			label="First name"
			maxLength={50}
			autocomplete="given-name"
			attrs={{ autocapitalize: 'words' }}
		/>
		<Field
			name="lastName"
			label="Last name"
			maxLength={50}
			autocomplete="family-name"
			attrs={{ autocapitalize: 'words' }}
		/>
		<Field
			name="email"
			label="Work email"
			type="email"
			maxLength={80}
			autocomplete="email"
			inputmode="email"
			attrs={{ autocapitalize: 'off', spellcheck: 'false' }}
		/>
		<Field name="company" label="Company" maxLength={80} autocomplete="organization" />

		<Select name="subject" label="What’s it about?" options={TOPIC_OPTIONS} optional class="cf__topic">
			<p class="cf__note" data-support-note hidden>
				<Icon name="tabler:info-circle" class="cf__note-icon" aria-hidden="true" />
				<span>
					On a paid plan? The{' '}
					<a href={SUPPORT_PORTAL_URL} target="_blank" rel="noopener noreferrer">
						Support portal
					</a>{' '}
					is the fastest way to reach our support engineers. Running ThingsBoard on your own servers? You can also ask
					on{' '}
					<a href={GITHUB_ISSUES_URL} target="_blank" rel="noopener noreferrer">
						GitHub issues
					</a>
					.
				</span>
			</p>
		</Select>

		{/* The range has no name: the hidden `devices` input carries the chosen stop in words. */}
		<div
			class="ui-field cf__devices"
			data-devices-field
			data-steps={JSON.stringify(DEVICE_STEPS)}
			data-not-sure={NOT_SURE}
		>
			<label class="ui-field__label" for="devices-range">
				<span data-devices-label>How many devices?</span>
				<span class="ui-field__optional">(optional)</span>
			</label>
			<input
				class="cf__range"
				type="range"
				id="devices-range"
				min="0"
				max={DEVICE_STEPS.length - 1}
				step="1"
				value="0"
				aria-valuetext={NOT_SURE}
			/>
			<div class="cf__range-ticks" aria-hidden="true">
				{DEVICE_STEPS.map(() => (
					<span />
				))}
			</div>
			<div class="cf__range-ends" aria-hidden="true">
				<span>Not sure</span>
				<span>1M+</span>
			</div>
			<output class="cf__range-value" for="devices-range" data-devices-value hidden></output>
			<input type="hidden" name="devices" id="devices" value="" />
		</div>

		<Field
			name="message"
			label="How can we help?"
			type="textarea"
			placeholder={DEFAULT_PROMPT}
			maxLength={3000}
			counter
			class="cf__full"
		/>

		<input type="hidden" name="utm_source" id="utm_source" />
		<input type="hidden" name="utm_medium" id="utm_medium" />
		<input type="hidden" name="utm_campaign" id="utm_campaign" />
		<input type="hidden" name="utm_term" id="utm_term" />
		<input type="hidden" name="utm_content" id="utm_content" />
		<input type="hidden" name="client_id" id="client_id" />
		<input type="hidden" name="fpr" id="fpr" />
		<input type="hidden" name="tags" id="tags" value="product" />
		<input type="hidden" name="form_id" id="form_id" value="contact_us" />
		<input type="hidden" name="path" id="path" value="" />
		<input type="hidden" name="_next" value="/contact-us-thanks/" />
		<input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
		<input type="hidden" class="form-rendered-at" value="" />
	</fieldset>

	<div class="cf__actions">
		<Button type="submit" size="lg" class="gtm_button" attrs={{ id: 'ContactUs_Submit', style: '--btn-min-w: 200px' }}>
			Send message
		</Button>
		<p class="cf__reassure">We’ll reply by email.</p>
	</div>
</Card>

{/*
	Inline, so an order link (?pcorder, ?subject=, ?message=) never shows the default form first: the topic
	is set here together with what it shows or hides.
*/}
<script is:inline>
	(() => {
		const form = document.getElementById('ContactUs');
		if (!form) return;
		const params = new URLSearchParams(window.location.search);

		if (params.has('pcorder')) form.dataset.variant = 'order';

		const subject = params.get('subject');
		const select = form.elements.namedItem('subject');
		if (subject && select && [...select.options].some((option) => option.value === subject)) {
			select.value = subject;
			const topic = select.selectedOptions[0].dataset;
			const devices = form.querySelector('[data-devices-field]');
			const note = form.querySelector('[data-support-note]');
			if (devices) devices.hidden = !('devices' in topic);
			if (note) note.hidden = !('support' in topic);
			form.elements.namedItem('message').placeholder = topic.prompt || '';
		}

		const message = params.get('message');
		if (message) form.elements.namedItem('message').value = message;
	})();
</script>

<script>
	import { CONTACT_SENT_FIELDS, CONTACT_SENT_KEY, type SentContact } from '@data/contact-form';
	import { FORMSPREE_CONTACT } from '@data/formspree';
	import { bindTrackingFields, EMAIL_PATTERN, guardSubmitWith, stampRenderedAt, XSS_PATTERN } from '@util/form-guard';
	import { validateAll, wireCounter, wireValidation, type FieldControl, type Problem } from '@util/form-validate';
	import { readSent, storeSent } from '@util/sent-form';

	const REQUIRED: Record<string, string> = {
		firstName: 'Enter your first name.',
		lastName: 'Enter your last name.',
		email: 'Enter your email so we can reply.',
		company: 'Enter your company. Working on your own? Your name is fine.',
		message: 'Tell us a little about what you need.',
	};

	function check(el: FieldControl): Problem {
		const value = el.value.trim();
		if (value === '') return { kind: 'required', message: REQUIRED[el.name] };
		if (el.name === 'email' && !EMAIL_PATTERN.test(value)) {
			return { kind: 'format', message: 'Enter an email like name@company.com.' };
		}
		if (XSS_PATTERN.test(value)) return { kind: 'format', message: 'Remove any HTML or script tags.' };
		return null;
	}

	function init(form: HTMLFormElement) {
		const control = <T extends Element>(name: string) => form.elements.namedItem(name) as T | null;
		const select = control<HTMLSelectElement>('subject');
		const message = control<HTMLTextAreaElement>('message');
		const devices = control<HTMLInputElement>('devices');
		const range = form.querySelector<HTMLInputElement>('#devices-range');
		const devicesField = form.querySelector<HTMLElement>('[data-devices-field]');
		const devicesLabel = form.querySelector<HTMLElement>('[data-devices-label]');
		const devicesValue = form.querySelector<HTMLOutputElement>('[data-devices-value]');
		const supportNote = form.querySelector<HTMLElement>('[data-support-note]');
		const submit = form.querySelector<HTMLButtonElement>('#ContactUs_Submit');
		if (!select || !message || !devices || !range || !devicesField || !devicesLabel || !devicesValue) return;

		const steps: string[] = JSON.parse(devicesField.dataset.steps || '[]');
		const notSure = devicesField.dataset.notSure ?? '';

		const topic = () => select.selectedOptions.item(0)?.dataset ?? {};

		const renderDevices = () => {
			const clients = topic().clients !== undefined;
			const step = Number(range.value);
			const text = step === 0 ? '' : `${steps[step]} ${clients ? 'clients' : 'devices'}`;
			devicesLabel.textContent = clients ? 'How many connected clients?' : 'How many devices?';
			devicesValue.textContent = text;
			devicesValue.hidden = step === 0;
			range.setAttribute('aria-valuetext', text || notSure);
			range.style.setProperty('--p', String(step / (steps.length - 1)));
			devices.value = text;
		};

		const applyTopic = () => {
			message.placeholder = topic().prompt ?? '';
			if (supportNote) supportNote.hidden = topic().support === undefined;
			const asksDevices = topic().devices !== undefined;
			devicesField.hidden = !asksDevices;
			// Disabled, so a count picked under another topic isn't sent with this one.
			devices.disabled = !asksDevices;
			renderDevices();
		};

		form.action = FORMSPREE_CONTACT;
		stampRenderedAt(form);

		const restored = new URLSearchParams(window.location.search).has('resend') ? readSent<SentContact>(CONTACT_SENT_KEY) : null;
		if (restored) {
			CONTACT_SENT_FIELDS.forEach((name) => {
				const el = control<FieldControl | HTMLSelectElement>(name);
				if (el && typeof restored[name] === 'string') el.value = restored[name];
			});
			if (select.selectedIndex < 0) select.value = '';
			if (typeof restored.devicesStep === 'string') range.value = restored.devicesStep;
		}

		applyTopic();
		select.addEventListener('change', applyTopic);
		range.addEventListener('input', renderDevices);
		wireCounter(message);
		if (restored) {
			const email = control<HTMLInputElement>('email');
			email?.focus();
			email?.select();
		}

		const fields = Object.keys(REQUIRED)
			.map((name) => control<FieldControl>(name))
			.filter((el): el is FieldControl => !!el);
		const markAttempted = wireValidation(fields, check);

		guardSubmitWith(form, () => {
			markAttempted();
			return validateAll(fields, check);
		});
		// After the guard: only a submit it let through is on its way.
		form.addEventListener('submit', (event) => {
			if (event.defaultPrevented) return;
			const sent = {
				at: Date.now(),
				devicesStep: range.value,
				order: form.dataset.variant === 'order',
			} as SentContact;
			CONTACT_SENT_FIELDS.forEach((name) => {
				sent[name] = control<FieldControl | HTMLSelectElement>(name)?.value.trim() ?? '';
			});
			storeSent(CONTACT_SENT_KEY, sent);
			// Disabled, so an answer left empty is not in the post at all.
			if (select.value === '') select.disabled = true;
			if (devices.value === '') devices.disabled = true;
			if (submit) submit.disabled = true;
		});

		// Back or a reload can bring the page back as it was left, mid-send, with the browser's own values.
		window.addEventListener('pageshow', () => {
			if (submit) submit.disabled = false;
			select.disabled = false;
			applyTopic();
		});

		const path = control<HTMLInputElement>('path');
		if (path) path.value = window.location.pathname;

		window.dataLayer = window.dataLayer || [];
		window.dataLayer.push({ event: 'contact-us', ...bindTrackingFields(form) });
	}

	const form = document.querySelector<HTMLFormElement>('#ContactUs');
	if (form) init(form);
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	@mixin range-track {
		height: var(--track);
		border-radius: 999px;
		background: linear-gradient(to right, var(--accent-fill) var(--fill), var(--color-border) var(--fill));
	}

	@mixin range-thumb {
		box-sizing: border-box;
		width: var(--thumb);
		height: var(--thumb);
		border: 2px solid var(--accent-fill);
		border-radius: 50%;
		background: var(--color-bg-surface);
		box-shadow: 0 1px 3px rgba(var(--color-shadow-ui-rgb), 0.2);
		transition: box-shadow 0.15s ease;
	}

	.cf {
		margin: 0;

		:where(p, h2) {
			margin: 0;
		}
	}

	.cf__title {
		@include type-card;
		margin-bottom: $spacing-5;
		color: var(--color-text);
	}

	.cf__fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-4;
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	// The topic takes the row when the device count is not asked.
	.cf__full,
	.cf__topic:has(~ .cf__devices[hidden]) {
		grid-column: 1 / -1;
	}

	// An order link has already set the topic.
	.cf[data-variant='order'] {
		.cf__topic {
			display: none;
		}

		.cf__devices {
			grid-column: 1 / -1;
		}
	}

	.cf__note {
		@include type-small;
		display: flex;
		gap: $spacing-2;
		padding: 10px 12px;
		border-radius: $radius-lg;
		background: color-mix(in srgb, var(--color-text) 5%, var(--color-bg-surface));
		color: var(--color-text);

		&[hidden] {
			display: none;
		}

		a {
			color: var(--accent-ink);
			font-weight: $font-weight-medium;
			text-underline-offset: 2px;
		}
	}

	.cf__note :global(.cf__note-icon) {
		flex: none;
		width: 18px;
		height: 18px;
		margin-top: 2px;
		color: var(--color-text-secondary);
	}

	.cf__devices {
		position: relative;
	}

	// `--p` (0 to 1) is the thumb's position, set by the script: the fill ends under the thumb's centre.
	.cf__range {
		--thumb: 24px;
		--track: 6px;
		--p: 0;
		--fill: calc(var(--thumb) / 2 + (100% - var(--thumb)) * var(--p));
		--ring: 0 0 0 6px color-mix(in srgb, var(--accent-fill) 18%, transparent);

		width: 100%;
		height: var(--thumb);
		margin: 6px 0 0;
		background: transparent;
		cursor: pointer;
		appearance: none;

		&:focus {
			outline: none;
		}

		// WebKit and Firefox each drop a rule that lists the other's pseudo-element, so they stay apart.
		&::-webkit-slider-runnable-track {
			@include range-track;
		}

		&::-moz-range-track {
			@include range-track;
		}

		&::-webkit-slider-thumb {
			@include range-thumb;
			margin-top: calc((var(--track) - var(--thumb)) / 2);
			appearance: none;
		}

		&::-moz-range-thumb {
			@include range-thumb;
		}

		&:hover::-webkit-slider-thumb,
		&:focus-visible::-webkit-slider-thumb {
			box-shadow: var(--ring);
		}

		&:hover::-moz-range-thumb,
		&:focus-visible::-moz-range-thumb {
			box-shadow: var(--ring);
		}
	}

	// One tick per stop, inset half a thumb so each sits under where the thumb lands.
	.cf__range-ticks {
		display: flex;
		justify-content: space-between;
		padding: 0 11px;

		span {
			width: 2px;
			height: 6px;
			border-radius: 1px;
			background: var(--color-border);
		}
	}

	.cf__range-ends {
		@include type-small;
		display: flex;
		justify-content: space-between;
		margin-top: -2px;
		color: var(--color-text-secondary);
	}

	// The chosen count takes the place of the scale's ends: both don't fit in one line.
	.cf__range-value {
		@include type-link;
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		color: var(--accent-ink);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;

		&[hidden] {
			display: none;
		}
	}

	.cf__devices:has(.cf__range-value:not([hidden])) .cf__range-ends {
		visibility: hidden;
	}

	.cf__actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: $spacing-3 $spacing-5;
		margin-top: $spacing-8;

		@include media-down(md) {
			flex-direction: column;
			align-items: stretch;
			text-align: center;
		}
	}

	.cf__reassure {
		@include type-small;
		color: var(--color-text-secondary);
	}
</style>
