---
import { Icon } from 'astro-icon/components';
import { MENU_SECTION_PROMOS } from '@data/menu-featured';

/**
 * The promo links at the bottom of a menu section (data in `data/menu-featured`): one row of
 * single-line links, each an icon and a title. The `featured` one uses the accent color and gets a
 * chevron. Renders nothing for a section without promos. Styled in `SiteMenu` under `sm__promo`.
 */
interface Props {
	section: string;
}

const { section } = Astro.props;
const promos = MENU_SECTION_PROMOS[section] ?? [];
---

{promos.length > 0 && (
	<div class="sm__promos">
		{promos.map((promo) => (
			<a
				class:list={['sm__promo', promo.linkClass, promo.featured && 'sm__promo--feat']}
				href={promo.href}
				{...promo.attrs}
			>
				<Icon name={promo.icon} class="sm__promo-icon" aria-hidden="true" />
				<span class="sm__promo-title">{promo.title}</span>
				{promo.featured && <Icon name="tabler:chevron-right" class="sm__promo-chev" aria-hidden="true" />}
			</a>
		))}
	</div>
)}
