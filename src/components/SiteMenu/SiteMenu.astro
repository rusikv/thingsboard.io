			// The row whose section is shown: accent color, a background tint and a 3px stripe at the left
			// edge. Only this row shows its chevron, pointing at the section it opened.
			.sm__sheet-row[aria-expanded='true'] {
				background: var(--sm-fill);
				color: var(--sm-accent);

				&::before {
					content: '';
					position: absolute;
					top: 8px;
					bottom: 8px;
					left: 0;
