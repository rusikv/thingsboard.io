		gap: 12px;
		padding: 12px calc(var(--sm-in) + var(--tb-scrollbar-comp, 0px)) calc(16px + env(safe-area-inset-bottom, 0px))
			var(--sm-in);
		border-top: 1px solid var(--sm-rule);
		background: var(--sm-surface);

		> * {
			flex: 1;
		}
	}

	// The Sign in and Try for free links in the menu sheet's footer (which the compact header no
	// longer shows) use the UI kit's 44px button size. They are styled together with the header's own
	// buttons, in `HeaderContent`.

	// The header while the menu sheet is open: it takes the menu sheet's background, so the header
	// and the menu sheet look like one piece with the header's bottom border between them, and the
	// Menu button becomes Close. A page's own CSS for the header over its hero banner must exclude
	// `[data-sm-open]`, as the header's own rules do.
	header.header[data-sm-open] {
		// Overrides the scrolled header's rules, which add a shadow and remove the bottom border.
		&,
		&[data-header-scrolled]:has(> [data-header-look]) {
			box-shadow: none;
		}

		&:has(> [data-header-look='marketing']),
		&[data-header-scrolled]:has(> [data-header-look='marketing']) {
			background-color: var(--color-bg-surface);
			border-bottom-color: var(--color-border);
		}

		.burger .icon-open {
			display: none;
		}
		.burger .icon-close {
			display: block;
		}
		// Both labels share one grid cell (`HeaderContent`), so the button has the same width in both
		// states.
		.burger .label-open {
			visibility: hidden;
		}
		.burger .label-close {
			visibility: visible;
		}
	}

	// Reduced motion: no chevron movement, no sliding underline and no panel opening animation. The
	// menu sheet's view transitions have their own rule above.
	@media (prefers-reduced-motion: reduce) {
		.sm__chev,
		.sm__sheet-chev,
		.sm__back svg,
		.sm__one,
		.sm__one-in,
		.sm__row::after {
			transition: none;
		}
	}

	// When the script moves the panel to another item while it is visible, skip its opening
	// transition (`movePanelTo`).
	.sm[data-moving] :is(.sm__one, .sm__one-in) {
		transition: none;
	}

	// Without JavaScript, section items cannot open and the Menu button cannot toggle. Instead, the
	// header's Menu is a link (`.sm__nojs`, shown by the `<noscript>` styles in `SiteMenuSheet`) that
	// targets the menu sheet, which then shows every section in one scrolling list.
	.sm__nojs {
		display: none !important;
	}

	// --- Which menu shows at which width ---
	@include width-below($menu-row-from) {
		.sm__row,
		.sm__one {
			display: none !important;
		}
	}
	@include width-from($menu-row-from) {
		.sm__sheet {
			display: none !important;
		}
	}
	@include width-from($bar-compact-below) {
		.sm__sheet-foot {
			display: none;
		}
