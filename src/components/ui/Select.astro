---
/**
 * A native select in the field's look: the label, the control and a chevron. An option marked
 * `placeholder` shows muted while it is the chosen one. The slot follows the control.
 */
import { Icon } from 'astro-icon/components';
import '@styles/ui-kit.scss';
import '@styles/ui-field.scss';

export interface SelectOption {
	value: string;
	label: string;
	selected?: boolean;
	/** Stands for "nothing chosen yet". */
	placeholder?: boolean;
	/** Data attributes a script reads off the chosen option. */
	attrs?: Record<string, string | undefined>;
}

export interface SelectGroup {
	group: string;
	options: SelectOption[];
}

interface Props {
	name: string;
	label: string;
	/** Default: the name. */
	id?: string;
	options: (SelectOption | SelectGroup)[];
	optional?: boolean;
	/** 44 or 48 tall. */
	size?: 'md' | 'lg';
	/** Visually hidden, never absent. */
	labelHidden?: boolean;
	class?: string;
	/** Extra attributes for the `<select>` itself. */
	attrs?: Record<string, string | undefined>;
}

const {
	name,
	label,
	options,
	optional = false,
	size = 'lg',
	labelHidden = false,
	class: className,
	attrs = {},
} = Astro.props;
const id = Astro.props.id ?? name;
---

<div class:list={['ui-field', `ui-field--${size}`, className]}>
	<label class:list={['ui-field__label', labelHidden && 'ui-sr']} for={id}>
		{label}
		{optional && <span class="ui-field__optional">(optional)</span>}
	</label>
	<div class="ui-field__row ui-select">
		<select class="ui-field__control ui-select__control" id={id} name={name} {...attrs}>
			{options.map((item) =>
				'group' in item ? (
					<optgroup label={item.group}>
						{item.options.map((option) => (
							<option value={option.value} selected={option.selected} {...option.attrs}>
								{option.label}
							</option>
						))}
					</optgroup>
				) : (
					<option
						value={item.value}
						selected={item.selected}
						data-placeholder={item.placeholder ? '' : undefined}
						{...item.attrs}
					>
						{item.label}
					</option>
				)
			)}
		</select>
		<Icon name="tabler:chevron-down" class="ui-select__chevron" aria-hidden="true" />
	</div>
	<slot />
</div>

<style is:global lang="scss">
	.ui-select {
		position: relative;
	}

	// Room for the chevron; 1px less where the field's 2px focus border takes it.
	.ui-field__control.ui-select__control {
		padding-right: 44px;
		cursor: pointer;
		appearance: none;

		&:focus {
			padding-right: 43px;
		}

		&:has(option[data-placeholder]:checked) {
			color: var(--color-text-muted);
		}

		option,
		optgroup {
			color: var(--color-text);
			background: var(--color-bg-surface);
		}
	}

	.ui-select__chevron {
		position: absolute;
		top: 50%;
		right: 14px;
		width: 20px;
		height: 20px;
		color: var(--color-text-secondary);
		transform: translateY(-50%);
		pointer-events: none;
	}
</style>
