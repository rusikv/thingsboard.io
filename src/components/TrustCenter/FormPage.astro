---
import FormPage, { type ElsewhereItem } from '@components/Landing/FormPage.astro';
import { tc } from '@data/trust-center/nav';
import './trust-center.scss';

/** A Trust Center form page (contact, document request, vulnerability report), with the way back to the hub. */

export type { ElsewhereItem };

interface Props {
	title: string;
	lede: string;
	description: string;
	/** The browser title. Default: the h1 and "· Trust Center". */
	metaTitle?: string;
	elsewhereTitle?: string;
	elsewhere: ElsewhereItem[];
	accent?: 'alert';
}

const { title, metaTitle = `${title} · Trust Center`, ...rest } = Astro.props;
---

<FormPage title={title} metaTitle={metaTitle} back={{ href: tc(), label: 'Trust Center' }} {...rest}>
	<slot name="intro" slot="intro" />
	<slot />
</FormPage>

<style lang="scss" is:global>
	body:has(.form-page[data-accent='alert']) .wave-bg {
		--wave-bg-color: var(--color-accent-red);
	}
</style>
