---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro, { type IntroPartAttrs } from '@components/Landing/PageIntro.astro';
import WaveBackground from '@components/Landing/WaveBackground.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';

/** A form page: the intro and other ways to reach us on the left, the form (the default slot) on the right. */

export interface ElsewhereItem {
	icon: string;
	lead: string;
	label: string;
	href: string;
	external?: boolean;
	accent?: string;
}

interface Props {
	title: string;
	lede: string;
	description: string;
	/** The browser title. Default: the h1. */
	metaTitle?: string;
	eyebrow?: string;
	/** A link above the intro, back to the section the page belongs to. */
	back?: { href: string; label: string };
	elsewhereTitle?: string;
	elsewhere: ElsewhereItem[];
	accent?: string;
	/** Attributes for the intro's parts, for a page script that rewrites them. */
	introAttrs?: IntroPartAttrs;
}

const {
	title,
	lede,
	description,
	metaTitle = title,
	eyebrow,
	back,
	elsewhereTitle = 'Looking for something else?',
	elsewhere,
	accent,
	introAttrs,
} = Astro.props;
---

<BaseLayout forceLightTheme title={metaTitle} description={description}>
	<WaveBackground />
	<div class="form-page" data-accent={accent}>
		<header class="form-page__intro">
			{back && (
				<Link href={back.href} dir="back" size="sm" class="form-page__back">
					{back.label}
				</Link>
			)}
			<PageIntro eyebrow={eyebrow} title={title} lede={lede} ledeMeasure="narrow" partAttrs={introAttrs} />
			{/* Before the form on phones too, where the aside falls below it. */}
			<slot name="intro" />
		</header>
		<div class="form-page__form">
			<slot />
		</div>
		<aside class="form-page__aside" aria-labelledby="form-page-aside-title">
			<h2 class="form-page__aside-title" id="form-page-aside-title">
				{elsewhereTitle}
			</h2>
			<ul class="form-page__list">
				{elsewhere.map((item) => (
					<li class="form-page__item" data-accent={item.accent}>
						<Mark size={48} icon={item.icon} fill="white" accent={item.accent ? undefined : 'neutral'} lift />
						<span class="form-page__text">
							<span class="form-page__lead">{item.lead}</span>
							<Link class="form-page__link" href={item.href} tone="ink" dir="none" external={item.external} wrap>
								{item.label}
							</Link>
						</span>
					</li>
				))}
			</ul>
		</aside>
	</div>
</BaseLayout>

<style lang="scss" is:global>
	// Let the fixed wave field show through the body.
	body:has(.form-page) {
		background-color: transparent;
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	.form-page {
		display: grid;
		grid-template-columns: minmax(0, 344px) minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		grid-template-areas:
			'intro form'
			'aside form';
		gap: 0 $spacing-10;
		max-width: $home-measure;
		margin: 0 auto;
		padding: $spacing-12 $spacing-5 $spacing-24;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: none;
			grid-template-areas: 'intro' 'form' 'aside';
			padding-top: $spacing-8;
			padding-bottom: $spacing-16;
		}

		:where(p, h2, ul) {
			margin: 0;
		}
	}

	.form-page__intro {
		grid-area: intro;
		padding-top: $spacing-6;

		@include media-down(lg) {
			padding-top: 0;
			margin-bottom: $spacing-8;
		}

		:global(.form-page__back) {
			margin-bottom: $spacing-5;
		}

		// The 344px intro column takes the title at the section size.
		:global(.page-intro__title) {
			@include media-up(lg) {
				font-size: $font-size-4xl;
			}
		}
	}

	.form-page__form {
		grid-area: form;
		min-width: 0;
	}

	.form-page__aside {
		display: grid;
		grid-area: aside;
		align-self: start;
		gap: $spacing-5;
		margin-top: $spacing-12;

		@include media-down(lg) {
			margin-top: $spacing-10;
		}
	}

	.form-page__aside-title {
		@include type-tile;
		color: var(--color-text);
	}

	.form-page__list {
		display: grid;
		gap: $spacing-5;
		padding: 0;
		list-style: none;

		@include media-down(lg) {
			@include media-up(md) {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: $spacing-5 $spacing-6;
			}
		}
	}

	.form-page__item {
		display: flex;
		align-items: flex-start;
		gap: 14px;

		@include media-down(lg) {
			@include media-up(md) {
				flex-direction: column;
				gap: $spacing-3;
			}
		}
	}

	.form-page__text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.form-page__lead {
		@include type-small;
		color: var(--color-text-secondary);
	}

	.form-page__item :global(.form-page__link) {
		overflow-wrap: anywhere;
	}

	@media print {
		.form-page__aside {
			break-inside: avoid;
		}
	}
</style>
