---
import SiteMenu from '@components/SiteMenu/SiteMenu.astro';
import HeaderScrollWatch from '@components/Landing/HeaderScrollWatch.astro';
import HeaderHeroWatch from '@components/Landing/HeaderHeroWatch.astro';
import SearchButton from '@components/SearchButton.astro';
import SiteSearch from '@components/SiteSearch.astro';
import GitHubButton from '@components/Landing/GitHubButton.astro';
import CloudRegionDialog from '@components/Landing/CloudRegionDialog.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';
import { CLOUD_SIGNIN, CLOUD_SIGNUP } from '@data/cta-destinations';
import type { HeaderConfig } from '@util/header-config';

interface Props {
	gitHubPlatform?: Products;
	// Always supplied by the only caller, starlight/Header.astro.
	headerConfig: HeaderConfig;
}

const { gitHubPlatform, headerConfig } = Astro.props;
const { look, hero, minimal } = headerConfig;

// The docs search page has its own search box, so the header leaves out its search button there.
const { pathname } = Astro.url;
const isDocsSearchPage = pathname.startsWith('/docs/') && pathname.endsWith('/search/');
const showSearch = headerConfig.search && !isDocsSearchPage;

// The marketing header changes when the page scrolls; the docs header never does. So the small
// inline script that watches scrolling (`HeaderScrollWatch`) is only added to marketing pages.
const needsScrollState = look === 'marketing';
const currentYear = new Date().getFullYear();
---

<div class="logo-burger" data-header-look={look} data-header-hero={hero}>
	<a href="/" class="logo" aria-label="Link to homepage"></a>
	<span class="header-copyright print:only">&copy; {currentYear} The ThingsBoard Authors</span>
</div>

{/* Minimal header (campaign landings): only the logo, with no menu, search or account buttons. */}
{!minimal && (
	<>
		{/* The menu comes before the right-hand buttons in the markup, so Tab moves through the logo,
		    the menu items, then search and the account buttons. The menu items are aligned toward the
		    logo, so the buttons arriving later in the HTML do not shift them while the page loads. */}
		<SiteMenu />

		<div class="head-buttons print:hidden" data-header-look={look} data-header-hero={hero}>
			{showSearch && (
				<div class="icon-buttons">
					<SearchButton />
				</div>
			)}
			<GitHubButton platform={gitHubPlatform} />
			{/* Both links open `CloudRegionDialog`; the hrefs are used when scripts are off. Sign in is a
			    secondary button with regular-weight text, like Menu and the star count, so Try for free is
			    the only emphasized button in the header. */}
			<a class="signin" href={CLOUD_SIGNIN.href} {...CLOUD_SIGNIN.attrs}>
				Sign in
			</a>
			<a
				id="Menu_TryItNow"
				class="try gtm_button"
				data-analytics-id="Menu_TryItNow"
				href={CLOUD_SIGNUP.href}
				{...CLOUD_SIGNUP.attrs}
			>
				Try for free
			</a>
			{/* Menu button: opens `SiteMenu`'s mobile menu sheet below 1200px, where the desktop menu row is
			    hidden. When scripts are off, the link below replaces it at every width and opens the sheet
			    through its `#sm-sheet` link target. */}
			<button type="button" data-sm-toggle aria-controls="sm-sheet" class="burger" aria-expanded="false">
				<Icon name="tabler:menu-2" class="icon-open" aria-hidden="true" />
				<Icon name="tabler:x" class="icon-close" aria-hidden="true" />
				<span class="burger__label">
					<span class="label-open">Menu</span>
					<span class="label-close">Close</span>
				</span>
			</button>
			<a href="#sm-sheet" class="burger sm__nojs">
				<Icon name="tabler:menu-2" aria-hidden="true" />
				<span>Menu</span>
			</a>
		</div>

		<CloudRegionDialog signupIds={headerConfig.cloudSignupIds} />

		{/* The search dialog, rendered once per page. The search button and keyboard shortcuts open it. */}
		{showSearch && <SiteSearch />}
	</>
)}

{needsScrollState && <HeaderScrollWatch />}
{hero === 'dark' && <HeaderHeroWatch />}

<script>
	import { menuRowQuery } from '@components/SiteMenu/menu-query';
	import { layerOver } from '@util/layers';

	// Swipe to open/close mobile menus:
	//   Starlight sidebar — swipe RIGHT from left edge to open, swipe LEFT to close
	//   Mobile menu sheet — swipe LEFT from right edge to open, swipe RIGHT to go back a level or close
	(function () {
		const OPEN_EDGE = 30; // px from screen edge that starts an open gesture
		const MIN_DIST = 60; // minimum horizontal travel to trigger
		const MAX_ANGLE = 35; // max degrees from horizontal (avoids triggering on scrolls)

		let startX = 0;
		let startY = 0;
		let tracking: 'sidebar' | 'menu' | null = null;

		// Starlight drops the sidebar's `popover` attribute on desktop viewports, where the sidebar
		// is always shown; `togglePopover()` throws on an element without it.
		function isSidebarDrawer() {
			return !!document.getElementById('starlight__sidebar')?.popover;
		}

		function isSidebarOpen() {
			return !!document.getElementById('starlight__sidebar')?.matches(':popover-open');
		}

		function isMenuOpen() {
			return document.querySelector('header.header')?.hasAttribute('data-sm-open') ?? false;
		}

		function triggerSidebar() {
			document.getElementById('starlight__sidebar')?.togglePopover();
		}

		// Clicks the Menu button instead of opening the sheet directly, so opening (and moving focus)
		// is handled in one place.
		function openMenu() {
			document.querySelector<HTMLButtonElement>('header.header [data-sm-toggle]')?.click();
		}

		// Swiping back first leaves an open section, then closes the sheet. `SiteMenu` handles `sm-back`
		// and decides which.
		function stepBack() {
			document.querySelector('[data-sm-sheet]')?.dispatchEvent(new CustomEvent('sm-back'));
		}

		document.addEventListener(
			'touchstart',
			(e) => {
				const t = e.touches[0];
				startX = t.clientX;
				startY = t.clientY;

				// An open sidebar gets the swipe, which closes it. When anything else covers the page (a
				// dialog, the search panel, a lightbox, a filter drawer; see `layerOver`), the swipe is left
				// to it: a lightbox uses swipes to change images, and a menu opened under it would be hidden.
				if (isSidebarOpen()) tracking = 'sidebar';
				else if (layerOver('menu')) tracking = null;
				else if (isMenuOpen()) tracking = 'menu';
				else if (startX <= OPEN_EDGE && isSidebarDrawer()) tracking = 'sidebar';
				// The sheet is the phone and tablet menu. The right-edge swipe does nothing where the desktop
				// menu row is shown, or on the minimal header, which has no Menu button.
				else if (
					startX >= window.innerWidth - OPEN_EDGE &&
					!matchMedia(menuRowQuery()).matches &&
					document.querySelector('header.header [data-sm-toggle]')
				)
					tracking = 'menu';
				else tracking = null;
			},
			{ passive: true }
		);

		document.addEventListener(
			'touchend',
			(e) => {
				const which = tracking;
				tracking = null;
				if (!which) return;

				const t = e.changedTouches[0];
				const dx = t.clientX - startX;
				const dy = t.clientY - startY;

				if (Math.abs(dx) < MIN_DIST) return;

				const angle = Math.abs(Math.atan2(Math.abs(dy), Math.abs(dx)) * (180 / Math.PI));
				if (angle > MAX_ANGLE) return;

				if (which === 'sidebar') {
					if (!isSidebarOpen() && dx > 0)
						triggerSidebar(); // swipe right → open
					else if (isSidebarOpen() && dx < 0) triggerSidebar(); // swipe left → close
				} else {
					if (!isMenuOpen() && dx < 0)
						openMenu(); // swipe left from right edge → open
					else if (isMenuOpen() && dx > 0) stepBack(); // swipe right → go back a level or close
				}
			},
			{ passive: true }
		);
	})();
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;
	@use '../../styles/button' as *;

	// Compact header: logo, icon buttons and Menu. Sign in and Try for free move to the bottom of the
	// mobile menu sheet.
	@mixin compact-bar {
		.head-buttons {
			.signin,
			.try {
				display: none;
			}
		}
	}

	// Menu button as an icon only. A square button looks the same in both states (Menu and Close), so
	// nothing shifts when it toggles.
	@mixin menu-square {
		.burger {
			width: 40px;
			padding: 0;

			// Still the button's accessible name, so hidden visually rather than with `display: none`.
			.burger__label {
				@include visually-hidden;
			}
		}
	}

	header.header {
		// The gutter the hero's text column uses, so the wordmark lines up with the headline.
		--tb-bar-inset: #{$bar-inset};
		position: fixed;
		// Sits below the promo banner; tracks the live offset so it slides to
		// top:0 as the banner collapses on scroll (--promo-cur → 0).
		top: var(--promo-cur, var(--promo-h, 0px));
		left: 0;
		// One duration for the header's background, border and shadow transitions, so they change
		// together.
		--tb-bar-swap: 0.2s;
		// The header's text and icons don't fade with the background: they switch color in one jump,
		// 0.06s into the 0.2s background fade. That is when the background reaches luminance 0.2, where
		// white and dark text are equally readable on it (56ms into the `ease` curve going light, 61ms
		// going dark). Fading both at once left gray text on a gray header (about 1.2:1 contrast) for
		// four frames at the end of a dark hero banner.
		--tb-ink-at: 0.06s;
		// Background of the header, and of the desktop menu panel, when scrolled over a dark hero banner:
		// the hero's own color (set by `HeaderHeroWatch`), so the header looks like part of the hero.
		// Near-black when the hero has no background color. Opaque on purpose: at 92% opacity, content
		// scrolling under it showed through as noise, and a backdrop blur to hide that had to re-blur
		// every frame of the homepage's hero video, which cost too much.
		--tb-bar-dark: var(--tb-hero-ground, rgb(8 9 14));
		// No `filter`: it would become the containing block for the fixed promo banner.
		transition:
			background-color var(--tb-bar-swap) ease,
			border-color var(--tb-bar-swap) ease,
			box-shadow var(--tb-bar-swap) ease;
		width: 100%;
		height: $header-height;
		z-index: 8888;
		// Reset Starlight's default border (variants opt back in); else it shows
		// through the transparent header.
		border-bottom: none;
		// Page-independent; else the header inherits Starlight's body line-height
		// (1.75 docs / 1.5 marketing) and its text renders taller on docs.
		line-height: $line-height-base;
		background-color: var(--sl-color-bg-sidebar);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 20px;

		.logo-burger {
			position: relative;
			display: flex;
			height: 100%;
			align-items: center;
			gap: 0.875rem;
			padding-left: calc(var(--tb-bar-inset) - 20px);
		}

		.head-buttons {
			// Always the last item in the header, whatever comes before it in the DOM.
			order: 1;
			// Every button here uses `currentColor`, so the text and icon color is set once, on this
			// container. It switches in one jump at `--tb-ink-at` instead of fading (see above).
			transition: color 0s linear var(--tb-ink-at);
			// These buttons never shrink to make room for the menu items: when squeezed, Try for free
			// wrapped onto two lines. The widths where the search field and the star count change size
			// are measured so the buttons always fit without shrinking.
			flex-shrink: 0;
			white-space: nowrap;
			padding-right: calc(var(--tb-bar-inset) - 20px);
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 8px;

			.icon-buttons {
				display: flex;
				align-items: center;
			}

			// Try for free has a minimum width larger than its label needs, so it keeps its size next to
			// Sign in.
			.try {
				--btn-min-w: 90px;

				@media screen and (min-width: 1500px) {
					--btn-min-w: 110px;
				}
			}

			// UI kit buttons fade their colors over 0.15s. In the header, text and border colors switch in
			// one jump at `--tb-ink-at` instead, like the rest of the header (see `--tb-ink-at` above).
			// The background still fades, so hover keeps its usual transition.
			:is(.signin, .try, .burger, .search-toggle-btn, .gh-button) {
				transition:
					color 0s linear var(--tb-ink-at),
					border-color 0s linear var(--tb-ink-at),
					background-color 0.15s ease;
			}
		}

		.logo {
			position: relative;
			display: block;
			// Logo sizes. The image is 168x44 and `contain` keeps its aspect ratio, so the width sets the
			// rendered size until the 50px height limits it (at 191px wide). 215px where the header has
			// room, 160px from 1200px to 1600px where the menu items, the right-hand buttons and the star
			// count all need space, and smaller sizes on phones.
			width: 175px;
			height: 50px;
			// The SVG has a left margin; this puts the glyph, not the box, on the inset.
			transform: translateX(-3.571%);
			background-image: url(../../assets/images/landings/thingsboard-logo.svg);
			background-size: contain;
			background-position: center center;
			background-repeat: no-repeat;
			transition: filter 0s linear var(--tb-ink-at);

			[data-theme='dark'] & {
				filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%) contrast(101%);
			}

			@media screen and (min-width: 1025px) {
				width: 215px;
			}

			@include width-from($menu-row-from) {
				@include width-below(1600px) {
					width: 160px;
				}
			}

			@media screen and (max-width: 767px) {
				width: 168px;
				height: 48px;
			}

			@media screen and (max-width: 480px) {
				width: 152px;
				height: 44px;
			}
		}
	}

	// --- Header buttons ---
	// Every header button gets its base look from the UI kit (`_button.scss`), applied once here: Sign
	// in, Try for free and Menu (this file), the search button (`SearchButton`), the GitHub star count
	// (`GitHubButton`) and the buttons at the bottom of the mobile menu sheet (`SiteMenu`). All of them
	// render only inside the header. Try for free is the primary button; the rest are secondary. The
	// header's buttons are 40px tall; the mobile menu sheet's buttons keep the UI kit's default 44px.
	// Each button's own rules (padding, width, when it shows) are nested under `.head-buttons` or the
	// sheet's footer, so they are more specific than these and win in any stylesheet load order.
	:is(.signin, .try, .burger, .search-toggle-btn, .gh-button, .sm__foot-signin, .sm__foot-try) {
		@include ui-button-base;
	}

	:is(.signin, .burger, .search-toggle-btn, .gh-button, .sm__foot-signin) {
		@include ui-button-secondary;
	}

	:is(.try, .sm__foot-try) {
		@include ui-button-primary;
	}

	:is(.signin, .try, .burger, .search-toggle-btn, .gh-button) {
		@include ui-button-size(sm);
	}

	:is(.sm__foot-signin, .sm__foot-try) {
		@include ui-button-size(md);
	}

	:is(.signin, .try, .burger, .search-toggle-btn, .gh-button, .sm__foot-signin, .sm__foot-try) {
		@include ui-button-forced-colors;
	}

	.head-buttons {
		// Regular-weight text, like Menu and the star count.
		.signin {
			font-weight: $font-weight-normal;
		}

		// Same button style as Sign in next to it: regular-weight text, with 14px side padding. Hidden
		// while the desktop menu row is shown (from `$menu-row-from`).
		.burger {
			--btn-px: 14px;

			display: none;
			font-weight: $font-weight-normal;

			svg {
				width: 20px;
				height: 20px;
			}

			.icon-close {
				display: none;
			}

			// Both labels share one grid cell, so the button is as wide as the longer word (Menu or Close)
			// in both states.
			.burger__label {
				display: grid;

				> * {
					grid-area: 1 / 1;
				}
			}

			.label-close {
				visibility: hidden;
			}
		}
	}

	// Below 1200px the desktop menu row is hidden and the Menu button opens the mobile menu sheet. The
	// logo area grows to fill the space the menu row used.
	@include width-below($menu-row-from) {
		header.header {
			.logo-burger {
				flex: 1;
			}

			.burger {
				display: flex;
			}
		}
	}

	// The full header needs about 560px with the search icon (a page without search has 48px more
	// room): the 168px logo, the 40px search icon, Sign in (about 76px), Try for free (110px), Menu
	// (94px), three 8px gaps and two 24px side insets. Below 600px, Sign in and Try for free move to the
	// bottom of the mobile menu sheet.
	@include width-below($bar-compact-below) {
		header.header {
			@include compact-bar;
		}
	}

	// The Menu button keeps its "Menu" label wherever the compact header has room for it. The labeled
	// button is 54px wider than the icon-only square (94px vs 40px). With the 152px logo and the search
	// icon it still fits at 360px wide, with about 19px to spare (measured with the system font); a page
	// without search has 48px more. Below 360px (or 320px without search) the button is the icon-only
	// square.
	@include width-below(360px) {
		header.header:has(> .head-buttons > .icon-buttons) {
			@include menu-square;
		}
	}

	@include width-below(320px) {
		header.header {
			@include menu-square;
		}
	}

	// ============================================
	// Header looks (docs, marketing) and their states
	// ============================================

	// `data-header-look` and `data-header-hero` are set on the header's direct children, so `:has(> …)`
	// only checks those instead of searching the whole header (or `.page`) on every style recalculation.

	// Docs header: the sidebar's background color and a 1px bottom border. It does not change on scroll.
	header.header:has(> [data-header-look='docs']) {
		border-bottom: 1px solid var(--sl-color-hairline-shade);
	}

	// Marketing header: the page background color and a 1px bottom border at the top of the page. Once
	// the page scrolls, a shadow replaces the border.
	header.header:has(> [data-header-look='marketing']) {
		background-color: var(--color-bg-surface);
		border-bottom: 1px solid var(--color-border);

		// A page with its own sticky bar under the header (the installations page) sets
		// `--tb-bar-shadow: none` while that bar is stuck, so the shadow shows under that bar instead.
		&[data-header-scrolled] {
			border-bottom-color: transparent;
			box-shadow: var(--tb-bar-shadow, var(--shadow-header));
		}
	}

	// Over a hero banner the header starts transparent, with no border or shadow. It gets its
	// background back once the page scrolls or the mobile menu sheet opens.
	header.header:not([data-sm-open]):not([data-header-scrolled]):has(> [data-header-hero]) {
		background-color: transparent;
		border-bottom-color: transparent;
		box-shadow: none;
	}

	// Over a dark hero banner the header uses white text and icons: at the top of the page, and after
	// scrolling while the hero is still under the header. Every button uses `currentColor`, so setting
	// `color` once is enough. The logo is an image, so a filter inverts it.
	@include bar-over-dark-hero {
		.logo {
			filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%) contrast(101%);
		}

		// This dark background comes from the header's state, not from a `data-surface` attribute, so
		// the dark focus ring and the dark secondary button style are applied here directly.
		.head-buttons {
			--focus-ring: var(--focus-ring-dark);

			color: $color-white;

			:is(.signin, .burger, .search-toggle-btn, .gh-button) {
				@include ui-button-secondary-dark;
			}
		}

		// The promo banner above a dark hero matches it: the hero's background, white text and the dark
		// menu's accent color. It is only visible at the top of the page, before it slides away.
		#promo-banner {
			background-color: var(--tb-hero-ground, rgb(8 9 14));
			border-bottom-color: rgba(255, 255, 255, 0.1);

			.promo-msg {
				color: rgba(255, 255, 255, 0.88);
			}

			.promo-msg strong,
			.promo-star,
			.promo-chevron {
				color: #b3c7ff;
			}
		}
	}

	// Scrolled, with the dark hero still under the header: the hero's background color, a faint light
	// bottom border, no shadow, and the text stays white. The border is hidden while the desktop menu
	// panel is open below the header.
	header.header:not([data-sm-open])[data-header-scrolled][data-header-over-hero]:has(> [data-header-hero='dark']) {
		background-color: var(--tb-bar-dark);
		border-bottom-color: rgba(255, 255, 255, 0.08);
		box-shadow: none;

		&[data-sm-desktop-open] {
			border-bottom-color: transparent;
		}
	}

	// On hero pages, Try for free keeps the wider 110px minimum width at every screen size.
	header.header:has(> [data-header-hero]) .try {
		--btn-min-w: 110px;
	}

	// On hero pages the content leaves no room for the header, which overlaps the hero. It still leaves
	// room for the promo banner, so the hero starts below the banner.
	.page > header.header:has(> [data-header-hero]) ~ .main-frame {
		padding-top: var(--promo-h, 0px);
	}

	// Starlight mobile sidebar: 90% width, toggle button left when closed / right edge when open
	@media (max-width: 50rem) {
		#starlight__sidebar {
			width: 90%;
		}

		.sl-menu-button {
			inset-inline-end: auto;
			inset-inline-start: var(--sl-nav-pad-x);
			// Just below the header bottom (= --promo-cur + header height); tracks the banner up as it hides.
			top: calc(var(--promo-cur, var(--promo-h, 0px)) + var(--header-height) + 0.75rem);
		}

		.sl-menu-button:has(~ :popover-open) {
			inset-inline-start: 90%;
		}

		// On pages with a TOC, the sidebar toggle is embedded inside the TOC bar
		html[data-has-toc] .sl-menu-button {
			display: none;
		}
		// But when the sidebar is open it covers the TOC bar, so restore the close button
		html[data-has-toc] .sl-menu-button:has(~ :popover-open) {
			display: flex;
		}
	}

	// Print: `position: fixed` above makes Chrome stamp this bar onto every sheet.
	// `static` returns it to the flow, where it lands once as a masthead.
	@media print {
		header.header {
			position: static;
			display: block;
			height: auto;
			padding: 0 0 0.6rem;
			margin: 0 0 1.5rem;

			// `!important` because the screen rules for the header over a hero are more specific (up to
			// (0,5,1)) and would otherwise print it without its bottom border, or on the hero's dark
			// background.
			& {
				border-bottom: 1px solid #d7d9e0 !important;
				background: none !important;
				box-shadow: none !important;
			}

			.logo-burger {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.25rem 1rem;
				height: auto;
				padding-left: 0;
			}

			.header-copyright {
				font-size: 0.8rem;
				color: #4a4d55;
			}

			// The wordmark is the `background-image` above, and Chrome skips
			// backgrounds unless the reader ticks "Background graphics". `content`
			// makes it a replaced element, which prints either way.
			.logo {
				content: url(../../assets/images/landings/thingsboard-logo.svg);
				width: 150px;
				height: auto;
				background-image: none;
				// Both the dark theme and the `transparent` variant invert this to
				// white at (0,3,1); `!important` covers either without racing them.
				filter: none !important;
			}
		}
	}
</style>
