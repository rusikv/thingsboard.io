---
/** A page's intro: eyebrow, h1 and lede. */

export interface IntroPartAttrs {
	eyebrow?: Record<string, string>;
	title?: Record<string, string>;
	lede?: Record<string, string>;
}

interface Props {
	title: string;
	lede?: string;
	eyebrow?: string;
	center?: boolean;
	ledeMeasure: 'wide' | 'narrow';
	titleId?: string;
	/** Attributes for the parts, for a page script that rewrites them. */
	partAttrs?: IntroPartAttrs;
}

const { title, lede, eyebrow, center = false, ledeMeasure, titleId, partAttrs = {} } = Astro.props;
---

<div class:list={['page-intro', center && 'page-intro--center', `page-intro--lede-${ledeMeasure}`]}>
	{eyebrow && (
		<p class="page-intro__eyebrow" {...partAttrs.eyebrow}>
			{eyebrow}
		</p>
	)}
	<h1 class="page-intro__title" id={titleId} {...partAttrs.title}>
		{title}
	</h1>
	{lede && (
		<p class="page-intro__lede" {...partAttrs.lede}>
			{lede}
		</p>
	)}
</div>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	:where(.page-intro) :is(p, h1) {
		margin: 0;
	}

	.page-intro--center {
		text-align: center;

		.page-intro__lede {
			margin-inline: auto;
		}
	}

	.page-intro__eyebrow {
		@include type-eyebrow;

		color: var(--accent-ink);
	}

	.page-intro__title {
		@include type-title;

		color: var(--color-text);
		text-wrap: balance;
	}

	.page-intro__eyebrow + .page-intro__title {
		margin-top: $spacing-3;
	}

	.page-intro__lede {
		@include type-lede;

		margin-top: $spacing-5;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.page-intro--lede-wide .page-intro__lede {
		max-width: 900px;
	}

	.page-intro--lede-narrow .page-intro__lede {
		max-width: 46ch;
	}
</style>
