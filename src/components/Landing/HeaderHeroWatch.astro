---
// Added only on pages with a dark hero banner (`hero="dark"`, see `HeaderContent`). Sets
// `data-header-over-hero` on the header while the hero, or a dark section right after it (such as the
// homepage's logo strip), is under the header's bottom edge. While it is set, the scrolled header keeps
// white text and icons on the hero's own background color (`--tb-hero-ground`). The header switches
// to its light background only when the page under it turns light, so its text color never flips while
// it is still over the hero. `HeaderScrollWatch` sets the header's other attribute,
// `data-header-scrolled`.
//
// How the dark area is found: start with the `#hero` element, then add each following sibling whose
// background is opaque and dark: weighted RGB brightness under 64 of 255 (`darkBackgroundColor`
// returns that color, or null).
// Elements with no height (scripts, styles) are skipped. The hero's background color is stored in
// `--tb-hero-ground`. A hero drawn with an image has no background color, so the header falls back to
// near-black.
//
// The IntersectionObserver watches a 1px line at the header's bottom edge, so it is rebuilt after a
// resize. That edge assumes the promo banner has already slid away on scroll. In browsers without
// scroll-driven animations the banner never slides away, so the header stays below it and the line is
// moved down by the header's `top` offset.
//
// Comments live here because comments inside `is:inline` would ship in every page's HTML.
---

<script is:inline>
	(function () {
		const header = document.querySelector('header.header');
		if (!header) return;

		function darkBackgroundColor(el) {
			const channels = getComputedStyle(el).backgroundColor.match(/[\d.]+/g);
			if (!channels) return null;
			const [r, g, b, a = 1] = channels.map(Number);
			const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
			return a > 0.9 && luminance < 64 ? `rgb(${r} ${g} ${b})` : null;
		}

		function watchHero() {
			const hero = document.getElementById('hero');
			if (!hero) return;
			const darkSections = [hero];
			for (let el = hero.nextElementSibling; el; el = el.nextElementSibling) {
				if (!el.offsetHeight) continue;
				if (!darkBackgroundColor(el)) break;
				darkSections.push(el);
			}
			const heroColor = darkBackgroundColor(hero);
			if (heroColor) document.documentElement.style.setProperty('--tb-hero-ground', heroColor);

			const bannerSlidesAway = CSS.supports('animation-timeline: scroll()');
			const underHeader = new Set();
			let observer = null;
			function observe() {
				if (observer) observer.disconnect();
				underHeader.clear();
				const headerBottom =
					header.offsetHeight + (bannerSlidesAway ? 0 : parseFloat(getComputedStyle(header).top) || 0);
				observer = new IntersectionObserver(
					function (entries) {
						for (const entry of entries) {
							if (entry.isIntersecting) underHeader.add(entry.target);
							else underHeader.delete(entry.target);
						}
						header.toggleAttribute('data-header-over-hero', underHeader.size > 0);
					},
					{ rootMargin: `-${headerBottom - 1}px 0px -${Math.max(0, innerHeight - headerBottom)}px 0px` }
				);
				darkSections.forEach(function (el) {
					observer.observe(el);
				});
			}
			observe();
			let resizeTimer = 0;
			addEventListener('resize', function () {
				clearTimeout(resizeTimer);
				resizeTimer = setTimeout(observe, 120);
			});
		}

		if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watchHero);
		else watchHero();
	})();
</script>
