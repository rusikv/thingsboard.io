---
import Default from '@astrojs/starlight/components/Head.astro';
import markdownCss from '@astrojs/starlight/style/markdown.css?inline';
import ThirdPartyScripts from '~/components/ThirdPartyScripts.astro';

const locals = Astro.locals as unknown as Record<string, unknown>;

// BaseLayout pages pass their marketing-formatted <title> via
// `Astro.locals.bslTitle`, and may opt out of the auto-emitted canonical
// link via `Astro.locals.bslNoCanonical = true`.
const bslTitle = locals.bslTitle;
if (typeof bslTitle === 'string') {
	for (const entry of Astro.locals.starlightRoute.head) {
		if (entry.tag === 'title') entry.content = bslTitle;
	}
}
if (locals.bslNoCanonical === true) {
	Astro.locals.starlightRoute.head = Astro.locals.starlightRoute.head.filter(
		(entry) => !(entry.tag === 'link' && entry.attrs && entry.attrs.rel === 'canonical')
	);
}

// Starlight's markdown.css, inlined only on the pages `MarkdownContent` gives `DocMarkdownContent`
// (BaseLayout sets `bsl` before Starlight renders this head), and on BaseLayout pages that render
// `.sl-markdown-content` themselves and set `bslMarkdownCss` in their frontmatter. Astro collects CSS by
// module graph, not by what renders, so importing it anywhere in the Starlight tree, or in any component
// that shares a CSS chunk with one, ships it to BaseLayout pages too, where its list-spacing rule matches
// nothing but its non-subject `:has()` makes every DOM insertion restyle the whole document. `?inline`
// gives the same minified CSS as the bundle. This sheet precedes the bundled CSS, so it first declares
// Starlight's layer order (from its `dist/style/layers.css`); without that, `starlight.content` would
// become the lowest sublayer. As before, these are the page's first `starlight.content` rules, so
// component overrides in that layer still come after them.
const markdownSheet =
	locals.bsl === true && locals.bslMarkdownCss !== true
		? undefined
		: '@layer starlight.base, starlight.reset, starlight.core, starlight.content, starlight.components, starlight.utils;' +
			markdownCss;
---

<Default {...Astro.props}><slot /></Default>
<ThirdPartyScripts />
{markdownSheet && <style is:inline set:html={markdownSheet}></style>}
